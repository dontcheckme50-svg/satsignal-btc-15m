# SATSIGNAL BTC 15M example configuration
# Copy to .env for local development. Never commit real credentials.
TRADING_MODE=paper
PREDICTOR_DB_PATH=/tmp/satsignal_btc15m_test.db
# Optional managed PostgreSQL (Supabase). When set, this takes precedence over SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require
PREDICTOR_STORAGE_MOUNT=/data
PREDICTOR_REQUIRE_PERSISTENT_STORAGE=0
HOST=0.0.0.0
PORT=8000
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
